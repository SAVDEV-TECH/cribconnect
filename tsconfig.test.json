{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "tests/**/*.ts",
    "lib/auth-security.ts",
    "lib/types.ts",
    "lib/data-store.ts",
    "lib/prisma.ts"
  ]
}
