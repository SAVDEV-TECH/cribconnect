# =======================================================
# CribConnect UNIPORT — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# =======================================================

# ------------------------------------------------------
# DATABASE (PostgreSQL — Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/cribconnect?sslmode=require"
# Optional Vercel Postgres alias:
# POSTGRES_URL="postgresql://user:password@host:5432/cribconnect?sslmode=require"

# ------------------------------------------------------
# AUTHENTICATION & ADMIN ACCESS (REQUIRED IN PRODUCTION)
# Generate with: openssl rand -hex 32 (minimum 16 characters)
NEXTAUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Comma-separated list of founder/admin email addresses allowed to access /admin
ADMIN_EMAILS="founder@cribconnect.ng"
NEXT_PUBLIC_SITE_URL="https://cribconnect-gold.vercel.app"

# ------------------------------------------------------
# GOOGLE IDENTITY SERVICES (Optional — enables Google Sign-In & One Tap)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ------------------------------------------------------
# PAYSTACK PAYMENTS & WEBHOOKS (Required for live Escrow & Pro upgrades)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# ------------------------------------------------------
# ESCROW BANK TRANSFER DETAILS (Optional fallback display)
NEXT_PUBLIC_ESCROW_BANK_NAME=""
NEXT_PUBLIC_ESCROW_ACCOUNT_NUMBER=""
NEXT_PUBLIC_ESCROW_ACCOUNT_NAME=""

# ------------------------------------------------------
# MEDIA STORAGE (Optional — uses PostgreSQL MediaAsset store if omitted)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

# ------------------------------------------------------
# AI LISTING PARSER (Optional — falls back to offline parser if omitted)
GEMINI_API_KEY=""
